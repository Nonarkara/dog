{
  "name": "dog-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3100",
    "build": "vite build",
    "preview": "vite preview",
    "test:domain": "esbuild src/domain/selftest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/selftest.mjs --log-level=error && node node_modules/.cache/selftest.mjs",
    "deploy": "vite build && wrangler deploy",
    "test:care": "esbuild scripts/test-care-domain.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/care-tests.mjs --log-level=error && node node_modules/.cache/care-tests.mjs",
    "test:auth": "esbuild scripts/test-email-auth.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/auth-tests.mjs --log-level=error && node node_modules/.cache/auth-tests.mjs",
    "test:push": "node scripts/test-push.cjs",
    "test:browser": "bash scripts/run-browser-tests.sh",
    "gate:widths": "node scripts/breakpoints.mjs",
    "gate": "widths=$(node scripts/breakpoints.mjs) && test -n \"$widths\" && node scripts/spatial/spatial-check.mjs --dir dist --baseline design/spatial-baseline.json --widths \"$widths\" --report",
    "gate:live": "widths=$(node scripts/breakpoints.mjs) && test -n \"$widths\" && node scripts/spatial/spatial-check.mjs --base https://dog.nonarkara.org --baseline design/spatial-baseline.json --widths \"$widths\" --report",
    "gate:falsify": "node scripts/spatial/spatial-falsify.mjs dist"
  },
  "dependencies": {
    "@clerk/backend": "3.26.5",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wrangler": "4.154.0"
  }
}
